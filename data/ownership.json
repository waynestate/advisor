{
    "_comment": "Who owns what in the stack. One row per topic: the project that owns it, what it does with it, and the projects that help around it. Hand-written; content:verify checks the shape and that every named project is known.",
    "topics": [
        {
            "topic": "composer audit",
            "owner": "PROCTOR",
            "role": "runs it (the composer-audit check)",
            "also": [
                {
                    "project": "Preflight",
                    "role": "CI job that calls PROCTOR"
                },
                {
                    "project": "CREED",
                    "role": "states the rule"
                }
            ]
        },
        {
            "topic": "supported PHP, Laravel and Node versions",
            "owner": "CREED",
            "role": "states the policy (policy.json support dates)",
            "also": [
                {
                    "project": "PROCTOR",
                    "role": "checks an app against it"
                },
                {
                    "project": "ADVISOR",
                    "role": "answers from it via policy_lookup"
                }
            ]
        },
        {
            "topic": "security headers and CSP",
            "owner": "HELMET",
            "role": "sets the security headers and the CSP on the response",
            "also": [
                {
                    "project": "CREED",
                    "role": "states the rule (runtime-and-headers chapter)"
                }
            ]
        },
        {
            "topic": "sign-in",
            "owner": "SESAME",
            "role": "sign-in inside the app (CAS, gateway assertion, OpenID Connect and OAuth2 drivers)",
            "also": [
                {
                    "project": "Drawbridge",
                    "role": "the gateway in front of the app"
                }
            ]
        },
        {
            "topic": "OpenID Connect gateway",
            "owner": "Drawbridge",
            "role": "the sign-in gateway (Microsoft Entra ID over OpenID Connect, signed assertions only)",
            "also": [
                {
                    "project": "SESAME",
                    "role": "verifies the signed assertion (gateway driver)"
                }
            ]
        },
        {
            "topic": "coding standard",
