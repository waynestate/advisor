  "decisions": {
    "internal": {
      "chrome": "wsu-app-bar--compact",
      "hasOfficialMasthead": false,
      "search": "inline field in the bar, collapsing to a row below the medium breakpoint"
    },
    "public": {
      "chrome": "official @waynestate/wsuheader and @waynestate/wsufooter",
      "hasOfficialMasthead": true,
      "search": "wsu-app-bar__search--expandable, because the masthead already has a wayne.edu field"
    },
    "note": "Both are APPLICATION templates. The difference is who can reach them, and therefore how much university identity they carry, not what they are for."
  }
