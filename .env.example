# ADVISOR reads the process environment only. It never loads this file itself;
# set these in your MCP client's "env" block, your shell, or (Laravel) your .env.
# Placeholders only. Nothing in here is a secret.

# Required. The server refuses to start unless this is 1 or true.
ADVISOR_ENABLED=1

# local, development, testing... "production" and "prod" always refuse to start.
ADVISOR_ENV=local

# Folder run_proctor_check may look inside. Default: the working directory.
# ADVISOR_PROJECT_ROOT=/path/to/your/app

# On by default. 0 or false allows tools that write (none exist in 0.1).
# ADVISOR_READ_ONLY=1

# Comma list of tool groups to offer: stack, proctor. Default: all.
# ADVISOR_GROUPS=stack

# Seconds before a PROCTOR run is stopped (1 to 900).
# ADVISOR_PROCTOR_TIMEOUT=120

# Seconds before a BOOSTER plan is stopped (1 to 900). A plan is local and fast,
# so the default is shorter than a PROCTOR run.
# ADVISOR_BOOSTER_TIMEOUT=60

# Where upgrade_path finds BOOSTER when the app has no vendor/bin/booster of its
# own: the path to booster's bin/booster (or a booster.phar). The app's own
# vendor/bin/booster always wins.
# ADVISOR_BOOSTER_BIN=/path/to/booster/bin/booster

# Largest piece of text one doc call returns (1000 to 45000).
# ADVISOR_MAX_CHARS=20000

# One JSON line per tool call (hashes of arguments, never the arguments).
# ADVISOR_AUDIT_LOG=/path/to/advisor-audit.log

# debug, info, notice, warning, error ... on stderr.
# ADVISOR_LOG_LEVEL=warning

# Only for content:generate: the folder that holds the sibling stack repos.
# ADVISOR_STACK_DIR=/path/to/stack

# Only for content:generate and the public-posture test: a file (kept outside
# the repo) with private strings to strip from the bundle. One literal or
# regex: pattern per line, # comments. See "Releasing" in the README.
# ADVISOR_PRIVATE_DENYLIST=/path/to/private-denylist.txt

# An extra module manifest (JSON with a "modules" list of Waynestate\ classes).
# ADVISOR_MODULES_FILE=/path/to/modules.json
